# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# .env.local is listed in .gitignore and must never be pushed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional, server-only. Used by later stages for server-side refund writes.
# Never expose this value to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
