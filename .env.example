# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# .env.local is listed in .gitignore and must never be pushed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional, server-only. Used by later stages for server-side refund writes.
# Never expose this value to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stage 3 hidden-order screen. Server-only OpenRouter key.
# Create a free key at https://openrouter.ai/keys and pick a :free model.
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
